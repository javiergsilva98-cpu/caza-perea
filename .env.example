# Copia este archivo a .env.local y rellena con los valores de tu proyecto
# Supabase (Project Settings → API). También hay que configurar estas mismas
# variables en Vercel (Project Settings → Environment Variables).

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Solo para el servidor — NUNCA con el prefijo NEXT_PUBLIC_ (se expondría en
# el navegador). Necesaria para que un admin pueda invitar cazadores desde
# la app (Perfil → "+ Invitar cazador"). Está en Project Settings → API →
# "service_role secret". Salta toda la seguridad de la base de datos:
# trátala como una contraseña maestra, no la compartas ni la subas a git.
SUPABASE_SERVICE_ROLE_KEY=eyJ...
